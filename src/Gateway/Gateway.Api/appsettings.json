{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TenantPermitPerMinute": 100,
    "AuthPermitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "web",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "tenant",
        "CorsPolicy": "web",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "tenants": {
        "ClusterId": "tenants",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "tenant",
        "CorsPolicy": "web",
        "Match": { "Path": "/api/tenants/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "notifications",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "tenant",
        "CorsPolicy": "web",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "tickets": {
        "ClusterId": "tickets",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "tenant",
        "CorsPolicy": "web",
        "Match": { "Path": "/api/tickets/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "identity-1": { "Address": "http://localhost:5081/" } }
      },
      "tenants": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "tenants-1": { "Address": "http://localhost:5083/" } }
      },
      "notifications": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "notifications-1": { "Address": "http://localhost:5082/" } }
      },
      "tickets": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "tickets-1": { "Address": "http://localhost:5080/" } }
      }
    }
  }
}
