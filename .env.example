# Copie para ".env" (que NÃO vai para o Git) e ajuste:  cp .env.example .env
#
# O docker compose lê o ".env" automaticamente.

# Chave de assinatura dos JWT (HS256). OBRIGATÓRIA e secreta: mínimo de 32 caracteres.
# Gere uma: openssl rand -base64 48
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-longa-com-mais-de-32-caracteres

# Credenciais da infraestrutura. Os valores abaixo são APENAS para desenvolvimento local.
# Em um volume já existente o Postgres mantém a senha antiga: mudar aqui não a altera.
POSTGRES_PASSWORD=helpdesk_dev
RABBITMQ_PASSWORD=helpdesk_dev
